# Biblioteca estandar: difflib.
#
# Comparacion y difusion de secuencias de texto. Calcula la
# similitud entre dos textos y produce parches en formato
# unificado (el mismo que usa git o diff -u).
#
# Uso:
#     import difflib
#     var a:list<string> = ["hola", "mundo"]
#     var b:list<string> = ["hola", "cruel", "mundo"]
#     print(difflib.unified_diff(a, b, "a.txt", "b.txt"))

import text

fn _lcs_len(a:string, b:string) -> int:
    var la:int = len(a)
    var lb:int = len(b)
    var prev:list<int> = []
    var j:int = 0

    while j <= lb:
        prev.add(0)
        j = j + 1

    var i:int = 1

    while i <= la:

        var c:string = substring(a, i - 1, 1)
        var curr:list<int> = []
        curr.add(0)
        j = 1

        while j <= lb:

            if c == substring(b, j - 1, 1):
                curr.add(prev[j - 1] + 1)
            else:

                if prev[j] >= curr[j - 1]:
                    curr.add(prev[j])
                else:
                    curr.add(curr[j - 1])

            j = j + 1

        prev = curr
        i = i + 1

    return prev[lb]

fn ratio(a:string, b:string) -> float:

    if len(a) == 0 and len(b) == 0:
        return 1.0

    var m:int = _lcs_len(a, b)
    return (2.0 * m) / (len(a) + len(b))

fn _edit_script(a:list<string>, b:list<string>) -> list<list<string>>:
    var m:int = len(a)
    var n:int = len(b)

    var dp:list<list<int>> = []
    var i:int = 0

    while i <= m:

        var fila:list<int> = []
        var j:int = 0

        while j <= n:
            fila.add(0)
            j = j + 1

        dp.add(fila)
        i = i + 1

    i = 1

    while i <= m:

        var j:int = 1

        while j <= n:

            if a[i - 1] == b[j - 1]:
                dp[i][j] = dp[i - 1][j - 1] + 1
            else:

                if dp[i - 1][j] >= dp[i][j - 1]:
                    dp[i][j] = dp[i - 1][j]
                else:
                    dp[i][j] = dp[i][j - 1]

            j = j + 1

        i = i + 1

    var script:list<list<string>> = []
    i = m
    var j:int = n

    while i > 0 or j > 0:

        if i > 0 and j > 0 and a[i - 1] == b[j - 1]:

            var nodo:list<string> = []
            nodo.add(" ")
            nodo.add(a[i - 1])
            script.add(nodo)
            i = i - 1
            j = j - 1
        else:

            if j > 0 and (i == 0 or dp[i][j - 1] >= dp[i - 1][j]):

                var nodo:list<string> = []
                nodo.add("+")
                nodo.add(b[j - 1])
                script.add(nodo)
                j = j - 1
            else:

                var nodo:list<string> = []
                nodo.add("-")
                nodo.add(a[i - 1])
                script.add(nodo)
                i = i - 1

    var reverso:list<list<string>> = []
    var k:int = len(script) - 1

    while k >= 0:
        reverso.add(script[k])
        k = k - 1

    return reverso

fn _normalize_order(script:list<list<string>>) -> list<list<string>>:
    var salida:list<list<string>> = []
    var n:int = len(script)
    var i:int = 0

    while i < n:

        if script[i][0] == " ":
            salida.add(script[i])
            i = i + 1
        else:

            var menos:int = 0
            var mas:int = 0
            var j:int = i

            while j < n and script[j][0] != " ":

                if script[j][0] == "-":
                    menos = menos + 1
                else:
                    mas = mas + 1

                j = j + 1

            var k:int = 0

            while k < menos:
                salida.add(script[i + k])
                k = k + 1

            k = 0

            while k < mas:
                salida.add(script[i + menos + k])
                k = k + 1

            i = j

    return salida

fn unified_diff(a:list<string>, b:list<string>, desde:string, hasta:string) -> list<string>:
    var script:list<list<string>> = _normalize_order(_edit_script(a, b))
    var salida:list<string> = []
    salida.add("--- " + desde)
    salida.add("+++ " + hasta)

    var contexto:int = 3
    var n:int = len(script)
    var i:int = 0

    while i < n:

        if script[i][0] == " ":
            i = i + 1
        else:

            var inicio:int = i - contexto

            if inicio < 0:
                inicio = 0

            var fin:int = i + contexto
            var cambios:int = 0

            while fin < n:

                if script[fin][0] != " ":
                    cambios = cambios + 1

                if cambios > contexto * 2:
                    break

                fin = fin + 1

            if fin > n - contexto:

                if n > contexto:
                    fin = n - contexto
                else:
                    fin = n

            var la:int = 0
            var lb:int = 0
            var p:int = 0

            while p < inicio:

                if script[p][0] != "+":
                    la = la + 1

                if script[p][0] != "-":
                    lb = lb + 1

                p = p + 1

            var cuenta_a:int = 0
            var cuenta_b:int = 0
            p = inicio

            while p < fin:

                if script[p][0] != "+":
                    cuenta_a = cuenta_a + 1

                if script[p][0] != "-":
                    cuenta_b = cuenta_b + 1

                p = p + 1

            salida.add("@@ -" + _range(la, cuenta_a) + " +" + _range(lb, cuenta_b) + " @@")
            p = inicio

            while p < fin:
                salida.add(script[p][0] + script[p][1])
                p = p + 1

            i = fin

    return salida

fn _range(inicio:int, cuenta:int) -> string:

    if cuenta == 0:
        return "" + _itoa(inicio) + ",0"

    if cuenta == 1:
        return _itoa(inicio)

    return _itoa(inicio) + "," + _itoa(cuenta)

fn _itoa(v:int) -> string:

    if v == 0:
        return "0"

    var neg:bool = false

    if v < 0:
        neg = true
        v = -v

    var digitos:string = ""
    var digitos_ref:string = "0123456789"

    while v > 0:
        digitos = substring(digitos_ref, v % 10, 1) + digitos
        v = v / 10

    if neg:
        return "-" + digitos

    return digitos

fn get_close_matches(palabra:string, posibilidades:list<string>, n:int, corte:float) -> list<string>:
    var candidatos:list<string> = []
    var puntajes:list<float> = []
    var i:int = 0

    while i < len(posibilidades):

        var r:float = ratio(palabra, posibilidades[i])

        if r >= corte:
            candidatos.add(posibilidades[i])
            puntajes.add(r)

        i = i + 1

    var m:int = len(candidatos)
    i = 0

    while i < m:

        var mejor:int = i
        var j:int = i + 1

        while j < m:

            if puntajes[j] > puntajes[mejor]:
                mejor = j

            j = j + 1

        if mejor != i:

            var pw:string = candidatos[i]
            candidatos[i] = candidatos[mejor]
            candidatos[mejor] = pw

            var pd:float = puntajes[i]
            puntajes[i] = puntajes[mejor]
            puntajes[mejor] = pd

        i = i + 1

    var salida:list<string> = []
    i = 0

    while i < m and len(salida) < n:
        salida.add(candidatos[i])
        i = i + 1

    return salida
