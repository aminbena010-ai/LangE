# Biblioteca estandar: rutas.
#
# Operaciones sobre rutas de ficheros con separador "/".
# No accede al disco: solo manipula texto.
#
# normalizar resuelve "." y "..", quita barras dobles y
# conserva la barra inicial si la ruta es absoluta. Si al
# final no queda nada devuelve "." (ruta relativa vacia).
#
# Uso:
#     import paths
#     print(paths.join("/usr", "local"))

import text

fn _last_index(t:string, sub:string) -> int:
    var i:int = len(t) - len(sub)

    while i >= 0:

        if substring(t, i, len(sub)) == sub:
            return i

        i = i - 1

    return -1

fn _without_last(lista:list<string>) -> list<string>:
    var nueva:list<string> = []
    var i:int = 0

    while i < len(lista) - 1:
        nueva.add(lista[i])
        i = i + 1

    return nueva

fn join(primera:string, segunda:string) -> string:

    if len(segunda) == 0:
        return primera

    if len(primera) == 0:
        return segunda

    if text.has_prefix(segunda, "/"):
        return segunda

    if text.has_suffix(primera, "/"):
        return primera + segunda

    return primera + "/" + segunda

fn name(ruta:string) -> string:
    var corte:int = _last_index(ruta, "/")

    if corte < 0:
        return ruta

    return substring(ruta, corte + 1, len(ruta) - corte - 1)

fn directory(ruta:string) -> string:
    var corte:int = _last_index(ruta, "/")

    if corte < 0:
        return ""

    if corte == 0:
        return "/"

    return substring(ruta, 0, corte)

fn extension(ruta:string) -> string:
    var base:string = name(ruta)
    var punto:int = _last_index(base, ".")

    if punto <= 0:
        return ""

    return substring(base, punto + 1, len(base) - punto - 1)

fn without_extension(ruta:string) -> string:
    var ext:string = extension(ruta)

    if len(ext) == 0:
        return ruta

    return substring(ruta, 0, len(ruta) - len(ext) - 1)

fn name_without_extension(ruta:string) -> string:
    return without_extension(name(ruta))

fn is_absolute(ruta:string) -> bool:
    return text.has_prefix(ruta, "/")

fn components(ruta:string) -> list<string>:
    var partes:list<string> = text.parts(ruta, "/")
    var salida:list<string> = []
    var i:int = 0

    while i < len(partes):

        if len(partes[i]) > 0:
            salida.add(partes[i])

        i = i + 1

    return salida

fn normalize(ruta:string) -> string:
    var absoluta:bool = is_absolute(ruta)
    var partes:list<string> = components(ruta)
    var salida:list<string> = []
    var i:int = 0

    while i < len(partes):
        var p:string = partes[i]

        if p == ".":
            i = i + 1
        else:

            if p == "..":

                if len(salida) > 0:

                    if salida[len(salida) - 1] != "..":
                        salida = _without_last(salida)
                    else:

                        if not absoluta:
                            salida.add("..")
                else:

                    if not absoluta:
                        salida.add("..")

                i = i + 1
            else:
                salida.add(p)
                i = i + 1

    if absoluta:
        return "/" + text.combine(salida, "/")

    if len(salida) == 0:
        return "."

    return text.combine(salida, "/")
