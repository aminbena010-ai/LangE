# Biblioteca estandar: string.
#
# Constantes y utilidades de texto con el nombre del modulo
# estandar de Python. Las operaciones generales viven en text.

fn digits() -> string:
    return "0123456789"

fn ascii_lowercase() -> string:
    return "abcdefghijklmnopqrstuvwxyz"

fn ascii_uppercase() -> string:
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

fn ascii_letters() -> string:
    return ascii_lowercase() + ascii_uppercase()

fn hexdigits() -> string:
    return "0123456789abcdefABCDEF"

fn punctuation() -> string:
    return "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~"

fn whitespace() -> string:
    return " \t\n\r"

fn title_words(texto:string) -> string:
    var palabras:list<string> = split(trim(texto), " ")
    var resultado:list<string> = []
    var i:int = 0

    while i < len(palabras):
        if len(palabras[i]) > 0:
            resultado.add(upper(substring(palabras[i], 0, 1)) + lower(substring(palabras[i], 1, len(palabras[i]) - 1)))
        i = i + 1

    return join(resultado, " ")

fn swap_case(texto:string) -> string:
    var minusculas:string = ascii_lowercase()
    var mayusculas:string = ascii_uppercase()
    var resultado:string = ""
    var i:int = 0

    while i < len(texto):
        var caracter:string = substring(texto, i, 1)

        if find(minusculas, caracter) >= 0:
            resultado = resultado + upper(caracter)
        else:
            if find(mayusculas, caracter) >= 0:
                resultado = resultado + lower(caracter)
            else:
                resultado = resultado + caracter

        i = i + 1

    return resultado
