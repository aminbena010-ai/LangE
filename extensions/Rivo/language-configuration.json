{
  "comments": {
    "lineComment": "#",
    "blockComment": ["#!", "!#"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "colorizedBracketPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "wordPattern": "(-?\\d+\\.?\\d*)|([A-Za-z_]\\w*)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:async)\\s+)?(?:fn|struct|if|elif|else|while|for|try|catch)\\b.*:\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:else|catch)\\b.*$"
  }
}
