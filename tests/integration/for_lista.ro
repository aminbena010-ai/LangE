fn main():
    var numeros:list<int> = [1, 2, 3, 4, 5]
    var suma:int = 0
    for n in numeros:
        suma = suma + n
    print(suma)
    for n in numeros:
        if n == 3:
            continue
        if n == 5:
            break
        print(n)
    print("________")
    for nombre in ["ana", "luis"]:
        print(nombre)
    var total:int = 0
    for a in [1, 2]:
        for b in [10, 20]:
            total = total + a * b
    print(total)
    var n:int = 100
    for n in [7]:
        print(n)
    print(n)
