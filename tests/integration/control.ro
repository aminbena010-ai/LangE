fn doble(x:int) -> int:
    return x * 2

fn main():
    print(doble(21))
    var j:int = 0
    while j < 10:
        j += 1
        if j == 3:
            continue
        if j == 5:
            break
    print(j)
    const C:int = 7
    print(C)
    print(true and false)
    print(10 >= 10)
    var k:int = 0
    if k == 0:
        k = 99
    print(k)
    if k == 99:
        print("si")
    else:
        print("no")
