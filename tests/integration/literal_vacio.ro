# Literal vacío `[]` (decisión 2026-10-06): el tipo lo
# aporta la anotación de la variable o constante, tanto
# para list como para map, y también en una asignación.

fn main():
    var l1:list<int> = []
    print(l1.len())

    var m:map<string, int> = []
    print(len(m))
    m["a"] = 1
    m["b"] = 2
    m.remove("a")
    m.remove("no_existe")
    print(len(m))

    var l2:list<int> = [7, 8]
    l2 = []
    print(l2.len())

    const CL:list<int> = []
    print(CL.len())

    const CM:map<string, int> = []
    print(len(CM))
