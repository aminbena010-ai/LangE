import date

fn main():
    print(date.date_to_epoch("1970-01-01"))
    print(date.epoch_to_date(0))
    print(date.epoch_to_date(date.date_to_epoch("2024-02-29")))
    print(date.days_between("2024-01-01", "2024-12-31"))
    print(date.days_between("2024-01-02", "2024-01-01"))
    print(date.add_days("2024-02-28", 1))
    print(date.add_days("2024-12-31", 1))
    print(date.add_days("2024-01-01", -1))
    print(date.is_leap_year(2024))
    print(date.is_leap_year(1900))
    print(date.is_leap_year(2000))
    print(date.is_valid_date("2024-02-29"))
    print(date.is_valid_date("2023-02-29"))
    print(date.is_valid_date("2024-13-01"))
    print(date.is_valid_date("2024-1-1"))
    print(date.day_of_week("2024-01-01"))
    print(date.day_of_week_name("2024-01-01"))
    print(date.day_of_week_name("1970-01-01"))
    print(date.days_in_month(2024, 2))
    print(date.days_in_month(2023, 2))
    print(date.days_in_month(2024, 13))
    print(date.month_name(1))
    print(date.month_name(12))
    print(date.month_name(0))
    print(len(date.current_date()))
    print(len(date.current_time()))
    print(len(date.current_datetime()))
    print(date.day_of_week("2023-10-07"))
