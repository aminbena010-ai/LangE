import statistics

fn main():
    var v:list<float> = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]
    print(statistics.sum(v))
    print(statistics.product([1.0, 2.0, 3.0]))
    print(statistics.mean(v))
    print(statistics.mean([1.0, 2.0]))
    print(statistics.min_list(v))
    print(statistics.max_list(v))
    print(statistics.range(v))
    print(statistics.median([1.0, 3.0, 5.0]))
    print(statistics.median([1.0, 2.0, 3.0, 4.0]))
    print(statistics.mode(v))
    print(statistics.variance(v))
    print(statistics.standard_deviation(v))
    print(statistics.percentile(v, 0.0))
    print(statistics.percentile(v, 100.0))
    print(statistics.percentile([10.0, 20.0, 30.0], 50.0))
    var vacia:list<float> = []
    print(statistics.mean(vacia))
    print(statistics.median(vacia))
    print(statistics.variance([5.0]))
    print(len(v))
    print(v[0])
